# --- secrets: never commit ---
.env
.env.*
!.env.example
!*/.env.example
*.key
*.pem
rootkey.csv

.claude/

.mvn/

.vscode/

# --- python ---
backend/venv/
__pycache__/
*.pyc

# --- runtime data (regenerated by the app) ---
backend/finals_buddy.db
backend/vector_store.json
backend/uploads/
backend/data/

# --- node / next ---
frontend/node_modules/
frontend/.next/
frontend/out/

# --- terraform ---
# Provider binaries are hundreds of MB, and state files record live resource
# detail that has no business in a public repo. The lock file IS committed, so
# everyone resolves the same provider versions.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/tfplan*
infra/terraform/*.tfplan

# --- misc ---
.DS_Store
*.log
backend/.auth_secret
ssh-key-2026-07-10.key.pub
.vscode/settings.json
DEPLOY.md

# contains admin_cidr, which is a personal IP address
infra/terraform/terraform.tfvars
